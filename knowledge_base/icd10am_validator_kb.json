      }
    }
  },
  "result_codes": {
    "VALID": "Valid ICD-10-AM code, acceptable as PDX",
    "INVALID_FORMAT": "Fails format check \u2014 reject",
    "INVALID_PDX": "Never acceptable as PDX \u2192 961Z",
